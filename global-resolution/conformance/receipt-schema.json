{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ga://schema/hypernet/conformance-receipt/v1",
  "title": "Ghost Atlas Hypernet Conformance Receipt",
  "type": "object",
  "required": ["resolution_id", "run_id", "commit_sha", "office_count", "control_count", "summary", "generated_at", "proof_chain"],
  "properties": {
    "resolution_id": {"const": "GA-HYPERNET-GLOBAL-RESOLUTION-010"},
    "run_id": {"type": "string", "minLength": 1},
    "commit_sha": {"type": "string", "minLength": 7},
    "office_count": {"const": 82},
    "control_count": {"minimum": 1, "type": "integer"},
    "summary": {
      "type": "object",
      "required": ["PASS", "PARTIAL", "FAIL"],
      "properties": {
        "PASS": {"type": "integer", "minimum": 0},
        "PARTIAL": {"type": "integer", "minimum": 0},
        "FAIL": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "generated_at": {"type": "string", "format": "date-time"},
    "proof_chain": {
      "type": "array",
      "prefixItems": [
        {"const": "SECA"},
        {"const": "DevOS"},
        {"const": "ProofGrid"},
        {"const": "Thoth"},
        {"const": "JANUS_PRIME"}
      ],
      "minItems": 5,
      "maxItems": 5
    },
    "artifact": {"type": "string"}
  },
  "additionalProperties": true
}
