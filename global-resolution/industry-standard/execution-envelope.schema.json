{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ga://schema/execution-envelope/v1",
  "title": "Ghost Atlas Hypernet Execution Envelope",
  "type": "object",
  "required": ["version","request_id","trace_id","idempotency_key","source","office_id","capability","input","policy","created_at"],
  "properties": {
    "version": {"const": "1.0"},
    "request_id": {"type": "string", "minLength": 8},
    "trace_id": {"type": "string", "minLength": 8},
    "idempotency_key": {"type": "string", "minLength": 8},
    "packet_id": {"type": ["string","null"]},
    "source": {"type": "string"},
    "office_id": {"type": "string", "pattern": "^ga://office/"},
    "chatbot_id": {"type": ["string","null"], "pattern": "^ga://chatbot/"},
    "role_id": {"type": ["string","null"], "pattern": "^ga://role/"},
    "capability": {"type": "string", "minLength": 1},
    "input": {"type": "object"},
    "policy": {
      "type": "object",
      "required": ["risk_class","timeout_ms","max_attempts","max_tool_hops","human_gate"],
      "properties": {
        "risk_class": {"enum": ["low","medium","high","critical"]},
        "timeout_ms": {"type": "integer", "minimum": 100, "maximum": 3600000},
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 5},
        "max_tool_hops": {"type": "integer", "minimum": 0, "maximum": 32},
        "human_gate": {"type": "boolean"},
        "preferred_runtime": {"type": ["string","null"]},
        "data_classification": {"enum": ["public","internal","confidential","restricted"]}
      },
      "additionalProperties": false
    },
    "created_at": {"type": "string", "format": "date-time"},
    "deadline_at": {"type": ["string","null"], "format": "date-time"},
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
